# Existing database/JWT variables remain required in production.
GOOGLE_CUSTOMER_CLIENT_IDS=
GOOGLE_BUSINESS_CLIENT_IDS=
# Random server-only secret, at least 32 characters. Never reuse JWT_SECRET.
AUTH_RESET_SECRET=
AUTH_MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true

# Deployment: set these in Render, never commit real values.
# SPRING_PROFILES_ACTIVE=prod,render
# DB_URL=jdbc:postgresql://NEON_DIRECT_HOST/DATABASE?sslmode=require
# DB_USERNAME=
# DB_PASSWORD=
# JWT_SECRET=
# DELIVERY_PIN_SECRET=
# CORS_ALLOWED_ORIGINS=https://siparo.app,https://isletme.siparo.app
# AWS_ENDPOINT_URL_S3=https://BRANCH_ID.storage.c-N.REGION.aws.neon.tech
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# UPLOADS_S3_BUCKET=siparo-images
